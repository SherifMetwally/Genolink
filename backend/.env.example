# Local: copy to .env and fill in.
# Hostinger: set these in the Node.js app Environment Variables panel (do not upload .env).

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_hostinger_mysql_username
DB_PASSWORD=your_hostinger_mysql_password
DB_NAME=your_hostinger_mysql_database

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

PORT=4000
NODE_ENV=production

# Portal origin(s), comma-separated
CORS_ORIGINS=https://admin.geno-link.com
